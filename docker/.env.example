# ============================================================
# scaffold docker-compose 环境变量（复制为 .env 后按环境修改）
#   cp docker/.env.example docker/.env
# 注意：.env 已被 .gitignore 排除（含密钥，不入仓库）
# ============================================================

# 镜像仓库前缀，必须以 / 结尾；置空 = 使用本地构建镜像
# 例：REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace/
REGISTRY=

# 镜像 tag（Jenkinsfile.simple 会以分支覆盖：master→prod，其余→dev）
TAG=dev

# ---------- 资源 ----------
MEM_BASE=256m
JAVA_OPTS_BASE=-Xms64m -Xmx192m -XX:+UseG1GC

# ---------- 端口（宿主机侧） ----------
PORT_GATEWAY=28080
PORT_NACOS=8848

# ---------- 中间件镜像（单机起步用；生产外置后可注释） ----------
NACOS_IMAGE=nacos/nacos-server:v2.3.2
REDIS_IMAGE=redis:7-alpine

# ---------- Nacos ----------
NACOS_USER=nacos
NACOS_PWD=nacos
# 生产建议走配置中心/密钥管理，不在 .env 明文扩散

# ---------- 应用 ----------
# 服务 profile：docker 内连 Nacos 配置中心，不要用 local（local 会禁用配置中心）
SPRING_PROFILES_ACTIVE=dev

# ---------- JWT SM2 签名密钥（SM2withSM3，JwtUtils 经 -D 系统属性 jwt.sm2.* 注入） ----------
# 默认值为 dev 联调密钥对（与 services/*-local.yml 一致）；生产必须替换为正式密钥对。
# 签发侧 gateway/auth 需私钥+公钥；下游 system/file/job/gen 等仅需公钥，且必须与签发方同一对。
# 缺失或非法时 JwtUtils 启动自检会打 ERROR 日志，运行期 token 解析将失败（登录态丢失）。
# 泄露后轮换需同步所有节点并强制重新登录。
JWT_SM2_PRIVATE_KEY=224d0cde8d6c8accb917d8d3759698f273495e01945b72584ac89034450b7488
JWT_SM2_PUBLIC_KEY=04aa796e22771f2a2e7d6ddeacdd07d9e0a1bad34949344cc79319c508d08838f1b67fd9d33fc452527a2b4b4f8bf7a57b0d3141434e49d0e8c42a21e1e1401e61
