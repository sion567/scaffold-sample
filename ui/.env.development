# 页面标题
VITE_APP_TITLE = 脚手架管理系统

# 开发环境配置
VITE_APP_ENV = 'development'

VITE_APP_BASE_API = '/dev-api'

# 开发后端地址（vite 代理目标）：前端开发人员统一连测试后端
# 自己本地起后端的，请在 .env.development.local 里覆盖该值（该文件已被 git 忽略）
VITE_APP_PROXY_TARGET = 'http://192.168.40.xxx:8080'

# 国密签名密钥（规范 V1.2）：会话签名密钥对由后端按会话签发（GET /auth/gm-sign-key），
# 登录后自动获取、仅内存持有、登出即销毁，前端无需任何密钥配置

# 天地图浏览器端 Key（免费申请：https://console.tianditu.gov.cn/）
# 不填则底图有水印，搜索降级为 OpenStreetMap（无需 Key），逆地理编码不可用
VITE_TIANDITU_KEY =
